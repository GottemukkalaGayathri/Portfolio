{
  "name": "gayathri-gottemukkala-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": { "dev": "concurrently -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"", "dev:api": "npm --workspace backend run dev", "dev:web": "npm --workspace frontend run dev", "build": "npm --workspace frontend run build", "start": "npm --workspace backend start" },
  "devDependencies": { "concurrently": "^9.1.2" }
}
